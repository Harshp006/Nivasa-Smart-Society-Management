# ============================================================
# Nivasa Smart Society Management — Environment Variables
# ============================================================
# Copy this file to backend/.env and fill in the values.
# Never commit actual .env files to version control.

# --- Database ---
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nivasa_db?schema=public"
# If using alternate port (e.g. Docker on 5433):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5433/nivasa_db?schema=public"

# --- JWT ---
JWT_SECRET="replace-with-a-long-random-secret-minimum-32-chars"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# --- Cookie ---
COOKIE_SECRET="replace-with-cookie-signing-secret"
COOKIE_SECURE=false

# --- Misc ---
BCRYPT_ROUNDS=12
LOG_LEVEL=info
